# Django Configuration
SECRET_KEY=django-insecure-event-qr-checkin-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# Supabase PostgreSQL Database Settings
# Option A: Connection string (URI) from Supabase Project Settings -> Database -> Connection URI
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Option B: Individual Supabase connection fields
# SUPABASE_DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=[YOUR-PASSWORD]
# SUPABASE_DB_PORT=5432

# (If neither DATABASE_URL nor SUPABASE_DB_HOST is set, Django defaults to local SQLite db.sqlite3)
